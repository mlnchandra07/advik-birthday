---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Advik's First Birthday 🎪 | September 15",
  description = "Join us for a magical Luxury Circus Carnival as we celebrate Advik Baragada's First Birthday! September 15 at Park Hyatt. RSVP now!",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- SEO -->
    <meta name="keywords" content="Advik birthday, first birthday, circus carnival, Park Hyatt, RSVP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- PWA -->
    <meta name="theme-color" content="#D4AF37" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Advik's Birthday" />
    <link rel="manifest" href="/manifest.json" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,700&family=Poppins:wght@300;400;500;600;700&family=Great+Vibes&family=Allura&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="cursor-sparkle">
    <!-- Sparkle cursor canvas -->
    <canvas id="sparkle-canvas" class="fixed inset-0 pointer-events-none" style="z-index: 999; mix-blend-mode: screen;"></canvas>

    <!-- Balloon container -->
    <div id="balloon-container" class="fixed inset-0 pointer-events-none" style="z-index: 40; overflow: hidden;"></div>

    <slot />

    <!-- Intersection Observer for reveal animations -->
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
      );

      document.querySelectorAll('.reveal').forEach((el) => {
        observer.observe(el);
      });
    </script>

    <!-- Sparkle cursor effect -->
    <script>
      const canvas = document.getElementById('sparkle-canvas') as HTMLCanvasElement;
      const ctx = canvas?.getContext('2d');
      if (ctx && canvas) {
        const sparkles: Array<{x: number; y: number; size: number; opacity: number; vx: number; vy: number; color: string}> = [];
        const colors = ['#D4AF37', '#F0D060', '#FFD700', '#C62828', '#FF6B35', '#ffffff'];

        function resizeCanvas() {
          canvas.width = window.innerWidth;
          canvas.height = window.innerHeight;
        }
        resizeCanvas();
        window.addEventListener('resize', resizeCanvas);

        document.addEventListener('mousemove', (e) => {
          for (let i = 0; i < 3; i++) {
            sparkles.push({
              x: e.clientX + (Math.random() - 0.5) * 20,
              y: e.clientY + (Math.random() - 0.5) * 20,
              size: Math.random() * 6 + 2,
              opacity: 1,
              vx: (Math.random() - 0.5) * 2,
              vy: (Math.random() - 1) * 2,
              color: colors[Math.floor(Math.random() * colors.length)],
            });
          }
        });

        function animateSparkles() {
          ctx!.clearRect(0, 0, canvas.width, canvas.height);
          for (let i = sparkles.length - 1; i >= 0; i--) {
            const s = sparkles[i];
            s.x += s.vx;
            s.y += s.vy;
            s.opacity -= 0.025;
            s.size *= 0.97;
            if (s.opacity <= 0) { sparkles.splice(i, 1); continue; }
            ctx!.save();
            ctx!.globalAlpha = s.opacity;
            ctx!.fillStyle = s.color;
            ctx!.beginPath();
            // Draw star shape
            for (let j = 0; j < 5; j++) {
              const angle = (j * 4 * Math.PI) / 5 - Math.PI / 2;
              const r = j % 2 === 0 ? s.size : s.size * 0.4;
              const x = s.x + r * Math.cos(angle);
              const y = s.y + r * Math.sin(angle);
              j === 0 ? ctx!.moveTo(x, y) : ctx!.lineTo(x, y);
            }
            ctx!.closePath();
            ctx!.fill();
            ctx!.restore();
          }
          requestAnimationFrame(animateSparkles);
        }
        animateSparkles();
      }
    </script>
  </body>
</html>
